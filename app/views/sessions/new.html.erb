<h1 class="text-center mt-4">Log in</h1>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-10">
      <%= form_with scope: :sessions, url: "login" , local: true do |f| %>

        <div class="form-group row mt-3">
          <%= f.label :email , class: "form-label text-light fs-5 px-0" %>
          <%= f.email_field :email , class: "form-control", placeholder: "Enter your email" %>
        </div>

        <div class="form-group row mt-3">
          <%= f.label :password , class: "form-label text-light fs-5 px-0" %>
          <%= f.password_field :password , class: "form-control", placeholder: "Enter a password" %>
        </div>

        <div class="form-group mt-3">
          <%= f.submit "Log in", class:"btn btn-primary" %>
        </div>

      <% end %>
    </div>
    <div class="text-center mt-3">
      <%= link_to "Cancel and return to article listing" , articles_path %>
    </div>
  </div>
</div>
