<div class="container">
  <div class="row justify-content-center">
    <div class="col-10">
      <%= render "shared/error" , obj: @article %>
      <%= form_with model: @article , local: true do |f| %>

        <div class="form-group row">
          <%= f.label :title , class: "form-label text-light fs-5 px-0"%>
          <%= f.text_field :title , class:"form-control" , placeholder: "Enter title"%>
        </div>

        <div class="form-group row mt-3">
          <%= f.label :description , class: "form-label text-light fs-5 px-0" %>
          <%= f.text_area :description , class: "form-control", rows:15, placeholder: "Enter description" %>
        </div>

        <div class="form-group row mt-3">
          <%= f.label :Category , class: "form-label text-light fs-5 px-0" %>
          <%= f.collection_select(:category_ids, Category.all, :id, :name, {prompt: "Please select your options (you can select multiple or leave empty)."} ,{ multiple: true, size: 3 , class: "form-select"})%>
        </div>

        <div class="form-group mt-3">
          <%= f.submit class:"btn btn-primary" %>
        </div>

      <% end %>
    </div>
    <div class="text-center mt-3">
      <%= link_to "Cancel and return to article listing" , articles_path %>
    </div>

  </div>
</div>
