<div class="container">
  <div class="row justify-content-center">
    <div class="col-10">
      <%= render "shared/error" , obj: @user %>
      <%= form_with model: @user , local: true do |f| %>

        <div class="form-group row">
          <%= f.label :username , class: "form-label text-light fs-5 px-0"%>
          <%= f.text_field :username , class:"form-control" , placeholder: "Enter a username"%>
        </div>

        <div class="form-group row mt-3">
          <%= f.label :email , class: "form-label text-light fs-5 px-0" %>
          <%= f.email_field :email , class: "form-control", placeholder: "Enter your email" %>
        </div>

        <div class="form-group row mt-3">
          <%= f.label :password , class: "form-label text-light fs-5 px-0" %>
          <%= f.password_field :password , class: "form-control", placeholder: "Create a password" %>
        </div>

        <div class="form-group mt-3">
          <%= f.submit(@user.new_record? ? "Sign Up" : "Update account", class:"btn btn-primary") %>
        </div>

      <% end %>
    </div>
    <div class="text-center mt-3">
      <%= link_to "Cancel and return to article listing" , articles_path %>
    </div>
  </div>
</div>
