<h1 class="text-center mt-4">Alpha Bloggerss</h1>

<% @user.each do |user| %>
  <div class="container">
    <div class="row justify-content-md-center mt-4">
      <div class="col-8">
        <div class="card text-center shadow mb-5 bg-body-tertiary rounded">
          <div class="card-header fst-italic">
            <%= link_to user.username , user %>
          </div>
          <div class="card-body">
            <h5 class="card-title"><%= link_to gravatar_for(user,size: 200) , user %></h5>
            <p class="card-text"><%= pluralize(user.articles.count, "countes") %></p>
            <%= link_to "View Profile" , user_path(user) , class:"btn btn-outline-success"%>
            <%= link_to "Edit Profile" , edit_user_path(user) , class:"btn btn-outline-info"%>
          </div>
          <div class="card-footer text-body-secondary">
            <small>
              Joined <%= time_ago_in_words(user.created_at) %> ago
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>